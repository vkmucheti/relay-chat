{
  "name": "@relay/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch dist/main.js",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "test": "pnpm build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "test:e2e": "pnpm build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.e2e.config.cjs --runInBand",
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/microservices": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/platform-socket.io": "12.6.0",
    "@nestjs/websockets": "12.6.0",
    "@relay/shared": "workspace:*",
    "@nestjs/config": "12.1.1",
    "@nestjs/mongoose": "12.0.1",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/terminus": "12.2.0",
    "@nestjs/throttler": "6.8.0",
    "@aws-sdk/client-s3": "3.1176.0",
    "@aws-sdk/s3-request-presigner": "3.1176.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "5.9.3",
    "kafkajs": "2.2.4",
    "mongoose": "9.13.0",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2"
  },
  "type": "module",
  "files": [
    "dist"
  ]
}
