resolver 127.0.0.11 valid=10s ipv6=off;
upstream gateway {
  zone relay_gateway 64k;
  least_conn;
  server api:3000 resolve;
}
upstream objects {
  zone relay_objects 64k;
  server minio:9000 resolve;
}
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen 8080;
  server_name ${RELAY_SERVER_NAME};
  location / { return 308 https://${RELAY_SERVER_NAME}${RELAY_HTTPS_PUBLIC_PORT}$request_uri; }
}
server {
  listen 8443 ssl;
  http2 on;
  server_name ${RELAY_SERVER_NAME};
  ssl_certificate /tls/fullchain.pem;
  ssl_certificate_key /tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:RelayTLS:10m;
  include /etc/nginx/headers.conf;
  add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self'; connect-src 'self' wss://${RELAY_SERVER_NAME}${RELAY_HTTPS_PUBLIC_PORT}; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
  root /var/www/relay;
  client_max_body_size 32k;
  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto https;
  location /api/ {
    proxy_pass http://gateway;
  }
  location ~ ^/api/docs(?:$|/|-) {
    proxy_hide_header Content-Security-Policy;
    include /etc/nginx/headers.conf;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'" always;
    proxy_pass http://gateway;
  }
  location ^~ /socket.io/ {
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 70s;
    proxy_send_timeout 70s;
    proxy_buffering off;
    proxy_pass http://gateway;
  }
  location ^~ /${S3_BUCKET}/ {
    error_log /dev/null emerg;
    client_max_body_size 10m;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_pass http://objects;
  }
  location = /health/live { proxy_pass http://gateway; }
  location = /health/ready { proxy_pass http://gateway; }
  location = /index.html {
    expires -1;
    try_files $uri =404;
  }
  location / {
    try_files $uri $uri/ /index.html;
  }
}
