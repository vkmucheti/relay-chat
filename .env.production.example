# Copy to .env.production for your own deployment. Values marked CHANGE are required.
# Compose sets APP_ROLE and the internal PORT for each Nest process.
APP_ENV=production
COOKIE_SECURE=true
TRUST_PROXY=1
RELAY_SERVER_NAME=chat.example.com
PUBLIC_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
RELAY_HTTPS_PUBLIC_PORT=:443
# Absolute directory containing fullchain.pem and privkey.pem in production.
RELAY_TLS_DIR=/absolute/path/to/tls
CORS_ORIGINS=https://chat.example.com
JWT_ACCESS_SECRET=CHANGE
JWT_REFRESH_SECRET=CHANGE
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
MONGO_URL=mongodb://mongo:27017/relay?replicaSet=rs0
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_CLIENT_ID=relay
KAFKA_SSL=false
# Optional managed Kafka settings, enabled together with TLS.
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
MINIO_ROOT_USER=relay-local
MINIO_ROOT_PASSWORD=CHANGE
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://chat.example.com
S3_REGION=us-east-1
S3_BUCKET=relay-media
S3_ACCESS_KEY=relay-local
S3_SECRET_KEY=CHANGE
DELETE_WINDOW_SECONDS=3600
PRESENCE_TTL_SECONDS=65
LOG_LEVEL=info
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE
