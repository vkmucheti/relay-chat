# Development defaults. For other environments supply strong random values and HTTPS.
# Compose sets APP_ROLE and the internal PORT for each Nest process.
APP_ENV=development
API_PORT=3000
WEB_PORT=4200
E2E_API_PORT=3001
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY=1
COOKIE_SECURE=false
JWT_ACCESS_SECRET=local-only-access-secret-replace-with-random-64-characters
JWT_REFRESH_SECRET=local-only-refresh-secret-replace-with-random-64-characters
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
MONGO_URL=mongodb://mongo:27017/relay?replicaSet=rs0
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_CLIENT_ID=relay
KAFKA_SSL=false
# Optional managed Kafka settings, enabled together with TLS.
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
MINIO_ROOT_USER=relay-local
MINIO_ROOT_PASSWORD=relay-local-storage
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=relay-media
S3_ACCESS_KEY=relay-local
S3_SECRET_KEY=relay-local-storage
DELETE_WINDOW_SECONDS=3600
PRESENCE_TTL_SECONDS=65
LOG_LEVEL=info
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=relay-local-grafana
# Seed is available in development only
DEMO_PASSWORD=RelayDemo2026!
